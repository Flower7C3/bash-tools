#!/usr/bin/env bash

# Scan the local network and a MAC inventory TSV for changes
# Usage: ./network-scan [OPTIONS] <inventory.tsv>

set -euo pipefail

APP_NAME='network-scan'
APP_VERSION='1.0.0'

main() {
  if [[ ! -f "$(dirname "$0")/common-functions" ]]; then
    echo "Downloading common-functions from GitHub..."
    if ! curl -fsSL https://raw.githubusercontent.com/Flower7C3/bash-tools/master/common-functions -o "$(dirname "$0")/common-functions"; then
      echo "Failed to download common-functions"
      exit 1
    fi
  fi

  # shellcheck source=common-functions
  source "$(dirname "$0")/common-functions"
  network_scan_main "$@"
}

network_scan_main() {
  show_usage() {
    log_usage_title '[OPTIONS] <inventory.tsv>'
    echo
    echo 'Scan local subnets, match MAC addresses from a TSV inventory,'
    echo 'refresh vendor (OUI), IP address and DNS hostname data'
    echo
    log_header 'Selection'
    log_usage_options_line '-m;--mac' \
      'Match inventory MACs against the local ARP/neighbour tables'
    log_usage_options_line '-n;--network' \
      'Actively sweep every host of the local subnet(s) and rebuild ARP data'
    echo
    log_header 'Columns'
    log_usage_options_line '--mac-col <NAME|N>' \
      'MAC column name or 1-based index (default: mac, adres_mac, or first)'
    log_usage_options_line '--ip-col <NAME|N>' \
      'IP column name or 1-based index (default: ip, adres_ip, adres)'
    log_usage_options_line '--name-col <NAME|N>' \
      'Own name column, never overwritten (default: name, nazwa)'
    log_usage_options_line '--vendor-col <NAME|N>' \
      'Vendor column (default: vendor, producent)'
    log_usage_options_line '--hostname-col <NAME|N>' \
      'Hostname column, created if missing (default: hostname). Filled only if the network has reverse DNS'
    log_usage_options_line '--type-col <NAME>' \
      'Device type column, created by --identify (default: typ)'
    echo
    log_header 'Network'
    log_usage_options_line '--subnet <CIDR>' \
      'Subnet to scan, repeatable (default: subnets of the local interfaces)'
    log_usage_options_line '--interface <NAME>' \
      'Limit subnet detection to this interface'
    log_usage_options_line '--timeout <MS>' \
      'Per-host ping timeout in milliseconds (default: 1000)'
    log_usage_options_line '--jobs <N>' \
      'Parallel ping workers (default: 64)'
    log_usage_options_line '--flush-arp' \
      'Flush the ARP cache before sweeping (destroys entries for devices that ignore ICMP)'
    log_usage_options_line '--no-sudo' \
      'Never re-exec with sudo (ARP tables may be incomplete)'
    echo
    log_header 'Vendor OUI database'
    log_usage_options_line '--oui-dir <DIR>' \
      "Cache directory (default: ~/.cache/bash-tools/oui)"
    log_usage_options_line '--oui-age <DAYS>' \
      'Re-download the OUI database when older than DAYS (default: 30)'
    log_usage_options_line '--no-download' \
      'Use only the cached OUI database, never download'
    echo
    log_header 'Output'
    log_usage_options_line '-o;--output <FILE>' \
      'Updated TSV (default: <input base>-updated.tsv)'
    log_usage_options_line '-r;--report <FILE>' \
      'Change report (default: <output base>-report.md)'
    log_usage_options_line '--add-new' \
      'Append devices found on the network that are missing from the inventory (default: on)'
    log_usage_options_line '--no-add-new' \
      'Never append new devices, only report them'
    log_usage_options_line '--status-col <NAME>' \
      'Online/offline/new status column, created if missing (default: status)'
    log_usage_options_line '--mac-typo-tolerance <N>' \
      'Correct a MAC that differs from a live device by up to N hex digits (default: 2)'
    log_usage_options_line '--no-dns' \
      'Skip reverse DNS (hostname) lookups'
    log_usage_options_line '--identify' \
      'Probe new/unknown devices (ports, HTTP title, mDNS/SSDP) to guess what they are'
    log_usage_options_line '--identify-ports <LIST>' \
      'Ports for --identify (default: 22,23,53,80,443,445,554,631,8080,8009,8443,9100)'
    log_usage_options_line '--identify-timeout <MS>' \
      'Per-port connect timeout for --identify (default: 700)'
    log_usage_options_line '--csv-dir <DIR>' \
      'Write per-section CSV files (breakdown, changes, identified devices)'
    log_usage_options_line '-v;--verbose' \
      'Verbose output'
    log_usage_options_line '-d;--debug' \
      'Debug output'
    log_usage_options_line '-u;--update' \
      'Update app'
    log_usage_options_line '-h;--help' \
      'Show this help message'
    echo
    log_header 'Examples'
    log_usage_example_line '-mn inventory.tsv'
    log_usage_example_line '-mn --identify --subnet 192.168.1.0/24 devices.tsv'
    log_usage_example_line '-m -o new.tsv -r changes.md devices.tsv'
    exit 0
  }

  local MAC_SCAN=0 NETWORK_SCAN=0
  local MAC_COL="" IP_COL="" NAME_COL="" VENDOR_COL="" HOSTNAME_COL="hostname" TYPE_COL="typ"
  local TIMEOUT_MS=1000 JOBS=64 NO_SUDO=0 FLUSH_ARP=0 IDENTIFY=0
  local IDENTIFY_PORTS="22,23,53,80,443,445,554,631,8080,8009,8443,9100" IDENTIFY_TIMEOUT_MS=700
  local OUI_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bash-tools/oui" OUI_AGE=30 NO_DOWNLOAD=0
  local OUTPUT="" REPORT="" NO_DNS=0 VERBOSE=0 CSV_DIR="" ADD_NEW=1 STATUS_COL="status"
  local MAC_TYPO_TOLERANCE=2
  # shellcheck disable=SC2034
  local DEBUG=0
  local -a SUBNETS=() INTERFACES=() INPUTS=()

  expand_short_flags() {
    local arg="$1" expanded=() i char
    if [[ ! "$arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
      printf '%s\n' "$arg"
      return
    fi
    for ((i = 1; i < ${#arg}; i++)); do
      char="-${arg:i:1}"
      case "$char" in
      -m | -n | -v | -d | -h | -u) expanded+=("$char") ;;
      *)
        printf '%s\n' "$arg"
        return
        ;;
      esac
    done
    printf '%s\n' "${expanded[@]}"
  }

  parse_arguments() {
    while [[ $# -gt 0 ]]; do
      case "$1" in
      -m | --mac)
        MAC_SCAN=1
        shift
        ;;
      -n | --network)
        NETWORK_SCAN=1
        shift
        ;;
      -[a-zA-Z][a-zA-Z]*)
        local -a _expanded=()
        while IFS= read -r _flag; do
          [[ -n "$_flag" ]] && _expanded+=("$_flag")
        done < <(expand_short_flags "$1")
        shift
        set -- "${_expanded[@]}" "$@"
        continue
        ;;
      --mac-col)
        MAC_COL="$2"
        shift 2
        ;;
      --ip-col)
        IP_COL="$2"
        shift 2
        ;;
      --name-col)
        NAME_COL="$2"
        shift 2
        ;;
      --vendor-col)
        VENDOR_COL="$2"
        shift 2
        ;;
      --hostname-col)
        HOSTNAME_COL="$2"
        shift 2
        ;;
      --type-col)
        TYPE_COL="$2"
        shift 2
        ;;
      --subnet)
        SUBNETS+=("$2")
        shift 2
        ;;
      --interface)
        INTERFACES+=("$2")
        shift 2
        ;;
      --timeout)
        TIMEOUT_MS="$2"
        shift 2
        ;;
      --jobs)
        JOBS="$2"
        shift 2
        ;;
      --flush-arp)
        FLUSH_ARP=1
        shift
        ;;
      --no-sudo)
        NO_SUDO=1
        shift
        ;;
      --oui-dir)
        OUI_DIR="$2"
        shift 2
        ;;
      --oui-age)
        OUI_AGE="$2"
        shift 2
        ;;
      --no-download)
        NO_DOWNLOAD=1
        shift
        ;;
      -o | --output)
        OUTPUT="$2"
        shift 2
        ;;
      -r | --report)
        REPORT="$2"
        shift 2
        ;;
      --no-dns)
        NO_DNS=1
        shift
        ;;
      --csv-dir)
        CSV_DIR="$2"
        shift 2
        ;;
      --add-new)
        ADD_NEW=1
        shift
        ;;
      --no-add-new)
        ADD_NEW=0
        shift
        ;;
      --status-col)
        STATUS_COL="$2"
        shift 2
        ;;
      --mac-typo-tolerance)
        MAC_TYPO_TOLERANCE="$2"
        shift 2
        ;;
      --identify)
        IDENTIFY=1
        shift
        ;;
      --identify-ports)
        IDENTIFY_PORTS="$2"
        shift 2
        ;;
      --identify-timeout)
        IDENTIFY_TIMEOUT_MS="$2"
        shift 2
        ;;
      -v | --verbose)
        VERBOSE=1
        shift
        ;;
      -d | --debug)
        DEBUG=1
        shift
        ;;
      -u | --update)
        update_application
        ;;
      -h | --help)
        show_usage
        ;;
      -*)
        log_error 'Unknown option: <b>%s</b>' "$1"
        show_usage
        ;;
      *)
        INPUTS+=("$1")
        shift
        ;;
      esac
    done
  }

  validate_input() {
    if [[ ${#INPUTS[@]} -ne 1 ]]; then
      log_error 'Provide exactly one TSV inventory file'
      show_usage
    fi

    if [[ ! -f "${INPUTS[0]}" ]]; then
      log_error 'File does not exist: <u>%s</u>' "${INPUTS[0]}"
      exit 1
    fi

    if [[ "$MAC_SCAN" -eq 0 && "$NETWORK_SCAN" -eq 0 ]]; then
      log_error 'Nothing to do: pass <b>--mac</b> and/or <b>--network</b>'
      show_usage
    fi

    if [[ ! "$TIMEOUT_MS" =~ ^[0-9]+$ ]] || [[ "$TIMEOUT_MS" -lt 1 ]]; then
      log_error '--timeout must be a positive number of milliseconds'
      exit 1
    fi

    if [[ ! "$JOBS" =~ ^[0-9]+$ ]] || [[ "$JOBS" -lt 1 ]]; then
      log_error '--jobs must be a positive number'
      exit 1
    fi

    if [[ ! "$OUI_AGE" =~ ^[0-9]+$ ]]; then
      log_error '--oui-age must be a number of days'
      exit 1
    fi

    if [[ ! "$IDENTIFY_TIMEOUT_MS" =~ ^[0-9]+$ ]] || [[ "$IDENTIFY_TIMEOUT_MS" -lt 1 ]]; then
      log_error '--identify-timeout must be a positive number of milliseconds'
      exit 1
    fi

    if [[ -n "$IDENTIFY_PORTS" && ! "$IDENTIFY_PORTS" =~ ^[0-9]+([[:space:],]+[0-9]+)*$ ]]; then
      log_error '--identify-ports must be a comma or space separated list of ports'
      exit 1
    fi

    if [[ ! "$MAC_TYPO_TOLERANCE" =~ ^[0-9]+$ ]] || [[ "$MAC_TYPO_TOLERANCE" -gt 6 ]]; then
      log_error '--mac-typo-tolerance must be a number between 0 and 6'
      exit 1
    fi
  }

  parse_arguments "$@"
  validate_input

  check_dependencies python3 curl
  log_title 'Network Scan' "$APP_VERSION"

  log_info ---icon '📄' 'Inventory: <u>%s</u>' "${INPUTS[0]}"

  if [[ "$NETWORK_SCAN" -eq 1 && "$NO_SUDO" -eq 0 ]]; then
    if [[ "$(id -u)" != "0" ]]; then
      log_info 'Re-running with sudo to populate ARP tables'
      exec sudo -- "$0" "$@"
    fi
  fi

  local _base="${INPUTS[0]}"
  _base="${_base%.*}"
  [[ -z "$OUTPUT" ]] && OUTPUT="${_base}-updated.tsv"
  [[ -z "$REPORT" ]] && REPORT="${OUTPUT%.*}-report.md"

  log_info ---icon '🔎' 'Mode: <b>%s</b>' "$([[ "$MAC_SCAN" -eq 1 && "$NETWORK_SCAN" -eq 1 ]] && echo 'mac + network' || { [[ "$MAC_SCAN" -eq 1 ]] && echo 'mac' || echo 'network'; })"
  log_info ---icon '💾' 'Output: <u>%s</u>' "$OUTPUT"
  log_info ---icon '📝' 'Report: <u>%s</u>' "$REPORT"

  _PROGRESS_LABEL=""
  _PROGRESS_TOTAL=0
  _PROGRESS_WIDTH=28

  if [[ ! -t 1 ]]; then
    _PROGRESS_WIDTH=0
  fi

  _finish_progress_bar() {
    [[ -n "$_PROGRESS_LABEL" ]] || return 0
    if [[ "$_PROGRESS_WIDTH" -gt 0 ]]; then
      printf '\r%100s\r' ""
    fi
    _PROGRESS_LABEL=""
  }

  _render_progress_bar() {
    local _done="$1" _total="$2"
    local _pct=0
    [[ "$_total" -gt 0 ]] && _pct=$((100 * _done / _total))

    if [[ "$_PROGRESS_WIDTH" -le 0 ]]; then
      log_info '%s: %d/%d (%d%%)' "$_PROGRESS_LABEL" "$_done" "$_total" "$_pct"
      return 0
    fi

    local _filled=0
    [[ "$_total" -gt 0 ]] && _filled=$((_PROGRESS_WIDTH * _done / _total))
    local _bar=""
    local _i
    for ((_i = 0; _i < _filled; _i++)); do
      _bar+='█'
    done
    for ((_i = _filled; _i < _PROGRESS_WIDTH; _i++)); do
      _bar+='░'
    done
    printf '\r%s %s %3d%% (%d/%d)' "$_PROGRESS_LABEL" "$_bar" "$_pct" "$_done" "$_total"
  }

  consume_py_logs() {
    local kind a b c
    while IFS=$'\t' read -r kind a b c; do
      case "$kind" in
      PROGRESS)
        if [[ "${_PROGRESS_LABEL:-}" != "$a" ]]; then
          _finish_progress_bar
          _PROGRESS_LABEL="$a"
          _PROGRESS_TOTAL="${c:-0}"
        fi
        _render_progress_bar "${b:-0}" "${c:-0}"
        ;;
      INFO)
        _finish_progress_bar
        log_info '%s' "$a"
        ;;
      OK)
        _finish_progress_bar
        log_success ---icon '✅' '%s' "$a"
        ;;
      WARN)
        _finish_progress_bar
        log_warning '%s' "$a"
        ;;
      ERR)
        _finish_progress_bar
        log_error '%s' "$a"
        ;;
      DEBUG) log_debug '%s' "$a" ;;
      STAT)
        _finish_progress_bar
        log_info ---icon '📊' '%s' "$a"
        ;;
      *)
        _finish_progress_bar
        [[ -n "$kind" ]] && log_info '%s' "$kind${a:+ $a}"
        ;;
      esac
    done
  }

  local _py_status=0
  local _py_fifo
  _py_fifo="$(mktemp -u "${TMPDIR:-/tmp}/${APP_NAME}.XXXXXX")"
  mkfifo "$_py_fifo"
  consume_py_logs <"$_py_fifo" &
  local _log_pid=$!
  MAC_SCAN="$MAC_SCAN" NETWORK_SCAN="$NETWORK_SCAN" \
    MAC_COL="$MAC_COL" IP_COL="$IP_COL" NAME_COL="$NAME_COL" VENDOR_COL="$VENDOR_COL" \
    HOSTNAME_COL="$HOSTNAME_COL" TYPE_COL="$TYPE_COL" \
    TIMEOUT_MS="$TIMEOUT_MS" JOBS="$JOBS" FLUSH_ARP="$FLUSH_ARP" \
    OUI_DIR="$OUI_DIR" OUI_AGE="$OUI_AGE" NO_DOWNLOAD="$NO_DOWNLOAD" \
    OUTPUT="$OUTPUT" REPORT="$REPORT" NO_DNS="$NO_DNS" CSV_DIR="$CSV_DIR" \
    ADD_NEW="$ADD_NEW" STATUS_COL="$STATUS_COL" MAC_TYPO_TOLERANCE="$MAC_TYPO_TOLERANCE" \
    IDENTIFY="$IDENTIFY" IDENTIFY_PORTS="$IDENTIFY_PORTS" \
    IDENTIFY_TIMEOUT_MS="$IDENTIFY_TIMEOUT_MS" \
    VERBOSE="$VERBOSE" DEBUG="$DEBUG" INPUT="${INPUTS[0]}" \
    SUBNETS="${SUBNETS[*]}" INTERFACES="${INTERFACES[*]}" \
    python3 - 2>"$_py_fifo" <<'PY' || _py_status=$?
import concurrent.futures
import csv
import datetime
import io
import ipaddress
import os
import platform
import re
import socket
import subprocess
import sys
import time
import urllib.request

MAC_SCAN = os.environ["MAC_SCAN"] == "1"
NETWORK_SCAN = os.environ["NETWORK_SCAN"] == "1"
MAC_COL = os.environ.get("MAC_COL", "")
IP_COL = os.environ.get("IP_COL", "")
NAME_COL = os.environ.get("NAME_COL", "")
VENDOR_COL = os.environ.get("VENDOR_COL", "")
HOSTNAME_COL = os.environ.get("HOSTNAME_COL", "") or "hostname"
TYPE_COL = os.environ.get("TYPE_COL", "") or "typ"
STATUS_COL = os.environ.get("STATUS_COL", "") or "status"
MAC_TYPO_TOLERANCE = int(os.environ["MAC_TYPO_TOLERANCE"])
ADD_NEW = os.environ["ADD_NEW"] == "1"
TIMEOUT_MS = int(os.environ["TIMEOUT_MS"])
JOBS = int(os.environ["JOBS"])
FLUSH_ARP = os.environ["FLUSH_ARP"] == "1"
OUI_DIR = os.environ["OUI_DIR"]
OUI_AGE = int(os.environ["OUI_AGE"])
NO_DOWNLOAD = os.environ["NO_DOWNLOAD"] == "1"
OUTPUT = os.environ["OUTPUT"]
REPORT = os.environ["REPORT"]
IDENTIFY = os.environ["IDENTIFY"] == "1"
IDENTIFY_PORTS = [
    int(p)
    for p in re.split(r"[\s,]+", os.environ["IDENTIFY_PORTS"])
    if p.strip().isdigit()
]
IDENTIFY_TIMEOUT_MS = int(os.environ["IDENTIFY_TIMEOUT_MS"])
CSV_DIR = os.environ.get("CSV_DIR", "")
NO_DNS = os.environ["NO_DNS"] == "1"
VERBOSE = os.environ["VERBOSE"] == "1"
DEBUG = os.environ.get("DEBUG", "0") == "1"
INPUT = os.environ["INPUT"]
SUBNETS = [s for s in os.environ.get("SUBNETS", "").split() if s]
INTERFACES = [s for s in os.environ.get("INTERFACES", "").split() if s]

IS_DARWIN = platform.system() == "Darwin"
MAC_RE = re.compile(r"(?<![0-9a-f:])([0-9a-f]{1,2}(?::[0-9a-f]{1,2}){5})(?![0-9a-f:])", re.I)
IPV4_RE = re.compile(r"(?<![0-9.])((?:\d{1,3}\.){3}\d{1,3})(?![0-9.])")


def log(kind, msg=""):
    print(f"{kind}\t{msg}", file=sys.stderr, flush=True)


def run(cmd, timeout=30):
    try:
        res = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
        return res.stdout, res.stderr, res.returncode
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as exc:
        return "", str(exc), 1


def normalize_mac(value):
    value = (value or "").strip().lower()
    if not value:
        return ""
    parts = value.replace("-", ":").split(":")
    if len(parts) != 6:
        return ""
    octets = []
    for part in parts:
        if not re.fullmatch(r"[0-9a-f]{1,2}", part):
            return ""
        octets.append(part.zfill(2))
    return ":".join(octets)


HEX_ONLY = re.compile(r"[^0-9a-f]")


def repair_mac(value):
    """Best-effort repair of a malformed MAC address.

    Returns (mac, note) where note explains what was changed, or ('', '')
    when the value cannot be salvaged.
    """
    raw = (value or "").strip().lower()
    if not raw:
        return "", ""
    strict = normalize_mac(raw)
    if strict:
        return strict, ""

    # Drop every non-hex character. This fixes stray separators and typos
    # such as "sb8:06:0d:41:18:55" (a leading letter, 7 groups) or dotted
    # / dash / space separated forms.
    digits = HEX_ONLY.sub("", raw)
    if len(digits) == 12:
        return ":".join(digits[i : i + 2] for i in range(0, 12, 2)), "reformatted, non-hex characters removed"

    # Too few digits: a leading zero may have been dropped by a spreadsheet.
    if len(digits) < 12 and digits:
        padded = digits.zfill(12)
        return normalize_mac(padded), f"padded to 12 digits ({len(digits)} found)"

    # More than 12 digits means the cell holds more than one value (two MACs
    # pasted together, or a MAC plus a note). Never guess a MAC from that:
    # a fabricated address silently collides with a real device's IP.
    return "", ""


def mac_similarity(a, b):
    """Number of differing hex digits between two MAC addresses."""
    return sum(1 for x, y in zip(a.replace(":", ""), b.replace(":", "")) if x != y)


def mac_prefix(mac):
    """Return OUI candidate prefixes, longest (MA-M/OUI-28) first."""
    raw = re.sub(r"[^0-9a-f]", "", mac.lower())
    out = []
    for length in (10, 8, 7, 6):
        if len(raw) >= length:
            out.append((length, raw[:length]))
    return out


def is_locally_administered(mac):
    try:
        first = int(re.sub(r"[^0-9a-f]", "", mac.lower())[:2], 16)
    except ValueError:
        return False
    return bool(first & 0x02)


def resolve_col(fieldnames, spec, fallbacks):
    names = [n for n in (fieldnames or [])]
    if spec:
        if spec.isdigit():
            idx = int(spec) - 1
            if idx < 0 or idx >= len(names):
                log("ERR", f"Column index out of range: {spec}")
                sys.exit(1)
            return names[idx]
        for name in names:
            if name.strip().lower() == spec.strip().lower():
                return name
        log("ERR", f"Column not found: {spec}")
        sys.exit(1)
    lowered = {name.strip().lower(): name for name in names}
    for cand in fallbacks:
        if cand in lowered:
            return lowered[cand]
    return None


# ---------------------------------------------------------------- inventory


raw = open(INPUT, encoding="utf-8-sig", newline="").read()
reader = csv.DictReader(io.StringIO(raw), delimiter=";")
fieldnames = [f.strip() for f in (reader.fieldnames or [])]
rows = list(reader)
if not fieldnames:
    log("ERR", "Inventory has no header row")
    sys.exit(1)
if DEBUG:
    log("DEBUG", f"columns={fieldnames}")

mac_key = resolve_col(
    fieldnames, MAC_COL, ("mac", "macaddress", "mac_address", "adres_mac", "adres mac")
)
ip_key = resolve_col(fieldnames, IP_COL, ("ip", "ipaddress", "ip_address", "adres_ip", "adres"))
name_key = resolve_col(fieldnames, NAME_COL, ("nazwa", "name", "own_name", "device_name"))
vendor_key = resolve_col(
    fieldnames, VENDOR_COL, ("vendor", "producent", "manufacturer", "oem", "oui")
)
if mac_key is None:
    log("ERR", "No MAC column found; use --mac-col to name it explicitly")
    sys.exit(1)

for key in (HOSTNAME_COL,):
    if key not in fieldnames:
        fieldnames.append(key)
if IDENTIFY and TYPE_COL not in fieldnames:
    fieldnames.append(TYPE_COL)
if STATUS_COL not in fieldnames:
    fieldnames.append(STATUS_COL)
if vendor_key is None:
    vendor_key = "vendor"
    if vendor_key not in fieldnames:
        fieldnames.append(vendor_key)
if DEBUG:
    log("DEBUG", f"mac={mac_key} ip={ip_key} name={name_key} vendor={vendor_key}")

invalid_rows = []
repaired_macs = []  # (line, original, repaired, note)
corrected_macs = []  # (typed, actual, distance)
inventory = []  # (row, mac, ip)
seen_macs = {}
for idx, row in enumerate(rows, start=2):
    original = (row.get(mac_key, "") if mac_key else "") or ""
    mac, note = repair_mac(original)
    if not mac:
        if any((v or "").strip() for v in row.values()):
            invalid_rows.append((idx, original.strip()))
        continue
    if note:
        if mac_key:
            row[mac_key] = mac
        repaired_macs.append((idx, original.strip(), mac, note))
    ip = (row.get(ip_key, "") if ip_key else "").strip()
    if ip:
        try:
            ip = str(ipaddress.ip_address(ip))
        except ValueError:
            log("WARN", f"Line {idx}: invalid IP '{ip}', ignored")
            ip = ""
    if mac in seen_macs:
        log("WARN", f"Line {idx}: duplicate MAC {mac} (first seen on line {seen_macs[mac]})")
        continue
