def http_title(ip, port):
    try:
        req = (
            f"GET / HTTP/1.0\r\nHost: {ip}\r\n"
            "User-Agent: bash-tools/network-scan\r\nConnection: close\r\n\r\n"
        )
        with socket.create_connection((ip, port), timeout=IDENTIFY_TIMEOUT_MS / 1000 + 2) as sock:
            sock.sendall(req.encode("latin-1", "replace"))
            sock.settimeout(IDENTIFY_TIMEOUT_MS / 1000 + 2)
            data = b""
            while len(data) < 8192:
                try:
                    chunk = sock.recv(4096)
                except OSError:
                    break
                if not chunk:
                    break
                data += chunk
    except OSError:
        return ""
    text = data.decode("utf-8", "replace")
    match = re.search(r"(?is)<title[^>]*>(.*?)</title>", text)
    if match:
        title = re.sub(r"\s+", " ", match.group(1)).strip()
        if title:
            return title[:120]
    match = re.search(r"(?im)^server:\s*(.+)$", text)
    if match:
        return match.group(1).strip()[:120]
    match = re.search(r"(?i)(HUAWEI|ASUS|TP-Link|D-Link|Netgear|Mercusys|Roku|Sonos|Chromecast|Amazon|Epson|Brother|Hikvision|Dahua)", text)
    return match.group(0) if match else ""


def ssdp_scan(timeout=2.5):
    """Return {ip: [friendly names]} using an SSDP M-SEARCH broadcast."""
    found = {}
    request = (
        "M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\n"
        'MAN: "ssdp:discover"\r\nMX: 1\r\nST: ssdp:all\r\n\r\n'
    )
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    sock.settimeout(0.5)
    try:
        sock.sendto(request.encode(), ("239.255.255.250", 1900))
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                data, _ = sock.recvfrom(8192)
            except socket.timeout:
                continue
            except OSError:
                break
            text = data.decode("utf-8", "replace")
            host = re.search(r"(?<![0-9.])((?:\d{1,3}\.){3}\d{1,3})(?![0-9.])", text)
            candidates = []
            for key in ("friendlyname", "server", "st", "nt", "usn"):
                match = re.search(rf"(?im)^{key}\s*:\s*(.+)$", text)
                if not match:
                    continue
                value = match.group(1).strip()
                if key in ("friendlyname", "usn"):
                    value = value.rsplit(":", 1)[-1].strip()
                if key == "st":
                    value = value.replace("upnp:", "").replace("schemas-", "").strip()
                if re.fullmatch(r"[0-9a-fA-F-]{36}", value):  # bare UUID
                    continue
                if re.fullmatch(r"\d+", value):
                    continue
                if value.lower() in ("rootdevice", "ssdp:all", "basic", "internetgatewaydevice"):
                    value = "UPnP " + value
                if value:
                    candidates.append(value)
            if host:
                found.setdefault(host.group(1), [])
                for value in candidates[:2]:
                    if value not in found[host.group(1)]:
                        found[host.group(1)].append(value)
    except OSError:
        pass
    finally:
        sock.close()
    return found


def mdns_lookup(ip):
    """Best-effort reverse name from the mDNS responder, macOS only."""
    if not IS_DARWIN:
        return ""
    out, _, rc = run(["dns-sd", "-G", "v4", ip], timeout=3)
    if rc != 0:
        return ""
    match = re.search(r"instance=([^\n]+)", out)
    return match.group(1).strip()[:80] if match else ""


