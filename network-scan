def ping_host(ip):
    if IS_DARWIN:
        cmd = ["ping", "-n", "-q", "-c", "1", "-W", str(max(1, TIMEOUT_MS)), str(ip)]
    else:
        secs = max(1, round(TIMEOUT_MS / 1000))
        cmd = ["ping", "-n", "-q", "-c", "1", "-W", str(secs), str(ip)]
    run(cmd, timeout=TIMEOUT_MS / 1000 + 5)


MAX_HOSTS = 65536


def sweep(subnet):
    if subnet.version != 4 or subnet.num_addresses < 3:
        return 0
    if subnet.num_addresses > MAX_HOSTS:
        log("WARN", f"{subnet} is too large, skipped (use a smaller --subnet)")
        return 0
    targets = [str(h) for h in subnet.hosts()]
    total = len(targets)
    done = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=JOBS) as pool:
        futures = {pool.submit(ping_host, ip): ip for ip in targets}
        for _ in concurrent.futures.as_completed(futures):
            done += 1
            log("PROGRESS", f"Sweeping {subnet}\t{done}\t{total}")
    return total


def read_arp():
    """Return list of (ip, mac)."""
    entries = []
    for cmd in (["arp", "-a"], ["ip", "neigh", "show"]):
        out, _, rc = run(cmd)
        if rc == 0 and out.strip():
            break
    else:
        out = ""
    if not out:
        try:
            with open("/proc/net/arp", encoding="utf-8") as fh:
                out = fh.read()
        except OSError:
            log("WARN", "No ARP table available")
            return entries

    for line in out.splitlines():
        ipm = IPV4_RE.search(line)
        macm = MAC_RE.search(line)
        if not ipm or not macm:
            continue
        ip = ipm.group(1)
        mac = normalize_mac(macm.group(1))
        try:
            ip = str(ipaddress.ip_address(ip))
        except ValueError:
            continue
        if not mac or ip == "0.0.0.0":
            continue
        addr = ipaddress.ip_address(ip)
        if addr.is_multicast or addr.is_loopback or addr.is_reserved:
            continue
        if normalize_mac(macm.group(1)).startswith("01:00:5e"):
            continue
        entries.append((ip, mac))
    if DEBUG:
        log("DEBUG", f"arp entries: {len(entries)}")
    return entries


