def guess_type(vendor, open_ports, names):
    vendor_l = (vendor or "").lower()
    names_l = " ".join(names).lower()
    for predicate, label in TYPE_RULES:
        try:
            if predicate(open_ports, vendor_l, names_l):
                return label
        except Exception:  # noqa: BLE001
            continue
    return "Nieznany typ"


def identify(ip, vendor, ssdp_names):
    open_ports = [p for p in IDENTIFY_PORTS if tcp_open(ip, p)]
    names = list(ssdp_names)
    title = ""
    for port in (80, 8080, 8009, 8443, 443):
        if port in open_ports:
            title = http_title(ip, port)
            if title:
                break
    if not title and not names:
        mdns_name = mdns_lookup(ip)
        if mdns_name:
            names.append(mdns_name)
    if title:
        names.append(title)
    hint = " ".join(names).lower()
    kind = guess_type(vendor, open_ports, names)
    if kind == "Nieznany typ" and not open_ports and not hint.strip():
        kind = "Brak odpowiedzi (śpi / ignoruje ICMP)"
    return {
        "ip": ip,
        "ports": open_ports,
        "title": title,
        "names": names,
        "type": kind,
    }


def _identify_one(ip, vendor, ssdp_names):
    try:
        return identify(ip, vendor, ssdp_names)
    except Exception as exc:  # noqa: BLE001
        log("WARN", f"identify failed for {ip}: {exc}")
        return {"ip": ip, "ports": [], "title": "", "names": [], "type": "Nieznany typ"}


