# --------------------------------------------------- topology diagram

gateway_ip = ""
if IS_DARWIN:
    _route, _, _rc = run(["route", "-n", "get", "default"])
    _m = re.search(r"gateway:\s*([0-9.]+)", _route)
else:
    _route, _, _rc = run(["ip", "route", "show", "default"])
    _m = re.search(r"default via ([0-9.]+)", _route)
if _m:
    gateway_ip = _m.group(1)

# Group devices by category (infrastructure first, IoT last) and keep the
# type inside the category as a sub-group, so the diagram reads top down in a
# useful order instead of by raw type name.
category_of_device = {}
for entry in inventory:
    row, mac, ip = entry
    info = identities.get(ip)
    online = ip in ip_to_mac
    if info:
        kind = info["type"]
    else:
        kind = "Offline" if not online else "Nieznany typ (online)"
    vendor = (row.get(vendor_key, "") or "").strip()
    category_of_device[mac] = (device_category(kind, vendor), kind)

grouped = {}
for entry in inventory:
    row, mac, ip = entry
    order, kind = category_of_device[mac]
    label = (row.get(name_key, "") if name_key else "") or ""
    # Unknown types collapse into one sub-group per category, otherwise each
    # unidentified device would get its own repeated heading.
    if kind.startswith("Nieznany typ") or kind == "Offline":
        kind = "Nieznany typ"
    # The gateway is already the root node of the diagram, listing it again in
    # a column would just duplicate it.
    if ip == gateway_ip:
        continue
    grouped.setdefault((order, kind), []).append((ip, label, mac, ip in ip_to_mac))

ordered_groups = sorted(
    grouped.items(),
    key=lambda kv: (kv[0][0], -len(kv[1]), kv[0][1]),
)

lines.extend(["", "## Network topology", ""])
if gateway_ip:
    lines.append("```mermaid")
    lines.append("graph TD")
    lines.append(f'    GW["Gateway {mermaid_escape(gateway_ip)}"]')
    lines.append("    style GW fill:#ffd,stroke:#333,stroke-width:3px")
    node_id = 0
    # Every category hangs directly off the gateway, so dagre puts the six
    # category headers side by side and each category then grows downwards as
    # its own column. One long single chain was unreadably tall, a single star
    # was unreadably wide (7372px); a grid of columns is the readable middle.
    by_order = {}
    for (order, kind), devices in ordered_groups:
        by_order.setdefault(order, []).append((kind, devices))


    for order in sorted(by_order):
        cat_label = CATEGORY_ORDER[order][1]
        cat_id = "C" + str(node_id)
        node_id += 1
        lines.append(f'    {cat_id}["{mermaid_escape(wrap_label(cat_label))}"]')
        lines.append(f"    style {cat_id} fill:#cde,stroke:#334,stroke-width:2px")
        lines.append(f"    GW --- {cat_id}")
        previous = cat_id
        for kind, devices in by_order[order]:
            if kind != cat_label:
                slug = "T" + str(node_id)
                node_id += 1
                lines.append(f'    {slug}["{mermaid_escape(wrap_label(kind))}"]')
                lines.append(f"    {previous} -.-> {slug}")
                previous = slug
            entries = sorted(devices, key=lambda t: ipaddress.ip_address(t[0]))
            shown = entries
            # Every edge target must be a node id, never a bare string:
            # mermaid rejects `A --> "text"` with a parse error.
            for ip, label, mac, online in shown:
                device_id = f"D{node_id}"
                node_id += 1
                lines.append(
                    f'    {device_id}["{mermaid_escape(wrap_label(label or mac) + "<br/>" + ip)}"]'
                )
                if online:
                    lines.append(f"    style {device_id} fill:#dfd,stroke:#3a3,stroke-width:1px")
