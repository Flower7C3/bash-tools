def device_category(kind, vendor=""):
    """Map a device type (and vendor as a fallback) to a CATEGORY_ORDER bucket."""
    low = (kind or "").lower()
    if "offline" in low or "brak odpowiedzi" in low:
        low = ""
    for index, keywords in CATEGORY_RULES:
        if any(keyword in low for keyword in keywords):
            return index
    vendor_low = (vendor or "").lower()
    for index, keywords in CATEGORY_VENDOR_FALLBACK:
        if any(keyword in vendor_low for keyword in keywords):
            return index
    return 5


