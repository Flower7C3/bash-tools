def local_subnets():
    if SUBNETS:
        nets = []
        for item in SUBNETS:
            try:
                nets.append(ipaddress.ip_network(item, strict=False))
            except ValueError:
                log("WARN", f"Ignoring invalid subnet: {item}")
        return nets

    nets = []
    if IS_DARWIN:
        out, _, _ = run(["ifconfig"])
        blocks = out.split("\n\n")
        iface_re = re.compile(r"^([A-Za-z0-9_.-]+):", re.M)
        addr_re = re.compile(r"^\s*inet (?:addr:)?([0-9.]+)(?:/([0-9]+))?(?: netmask (0x[0-9a-fA-F]+))?", re.M)
    else:
        out, _, _ = run(["ip", "-o", "-4", "addr"])
        blocks = [line for line in out.splitlines() if line.strip()]
        iface_re = re.compile(r"^\d+:\s+([A-Za-z0-9_.@-]+)")
        addr_re = re.compile(r"\sinet\s+([0-9.]+)/([0-9]+)")

    def bits_from_netmask(mask):
        return int(mask[2:], 16).bit_count()

    for block in blocks:
        imatch = iface_re.search(block)
        if not imatch:
            continue
        iface = imatch.group(1)
        if INTERFACES and iface not in INTERFACES:
            continue
        for amatch in addr_re.finditer(block):
            addr, bits, hexmask = amatch.group(1), amatch.group(2), amatch.group(3)
            if addr.startswith("127."):
                continue
            try:
                if bits:
                    net = ipaddress.ip_network(f"{addr}/{bits}", strict=False)
                elif hexmask:
                    net = ipaddress.ip_network(f"{addr}/{bits_from_netmask(hexmask)}", strict=False)
                else:
                    continue
            except ValueError:
                continue
            if net not in nets:
                nets.append(net)
                if DEBUG:
                    log("DEBUG", f"subnet from {iface}: {net}")
    if not nets:
        log("WARN", "Could not detect local subnets, use --subnet")
    return nets


