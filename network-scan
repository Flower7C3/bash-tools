def oui_age_seconds():
    oldest = None
    for name, _ in OUI_URLS:
        path = os.path.join(OUI_DIR, name)
        if os.path.exists(path):
            age = time.time() - os.path.getmtime(path)
            oldest = age if oldest is None else max(oldest, age)
    return oldest


def download_oui():
    os.makedirs(OUI_DIR, exist_ok=True)
    todo = [
        (name, url)
        for name, url in OUI_URLS
        if not (os.path.exists(os.path.join(OUI_DIR, name)) and os.path.getsize(os.path.join(OUI_DIR, name)) > 0)
    ]
    age = oui_age_seconds()
    refresh = age is not None and age > OUI_AGE * 86400
    if refresh:
        todo = list(OUI_URLS)

    for index, (name, url) in enumerate(todo, 1):
        dest = os.path.join(OUI_DIR, name)
        label = "Refreshing OUI" if refresh else "Downloading OUI"
        log("PROGRESS", f"{label} {name}\t{index}\t{len(todo)}")
        if DEBUG:
            log("DEBUG", f"downloading {url}")
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "bash-tools/network-scan"})
            with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as fh:
                while True:
                    chunk = resp.read(262144)
                    if not chunk:
                        break
                    fh.write(chunk)
        except Exception as exc:  # noqa: BLE001
            log("WARN", f"OUI download failed ({name}): {exc}")


def load_oui():
    table = {}
    if not os.path.isdir(OUI_DIR):
        return table
    for file_index, (name, _) in enumerate(OUI_URLS, 1):
        path = os.path.join(OUI_DIR, name)
        if not os.path.exists(path) or os.path.getsize(path) == 0:
            continue
        log("PROGRESS", f"Reading OUI {name}\t{file_index}\t{len(OUI_URLS)}")
        try:
            with open(path, encoding="utf-8", errors="replace", newline="") as fh:
                for record in csv.DictReader(fh):
                    keys = {k.strip().lower(): v for k, v in record.items() if k}
                    assignment = (keys.get("assignment") or "").strip()
                    org = (keys.get("organization name") or "").strip()
                    if not assignment or not org:
                        continue
                    prefix = re.sub(r"[^0-9a-f]", "", assignment.lower())
                    table.setdefault(prefix, org)
        except OSError as exc:
            log("WARN", f"Cannot read {path}: {exc}")
    if DEBUG:
        log("DEBUG", f"OUI prefixes loaded: {len(table)}")
    return table


