                    lines.append(
                        f"    style {device_id} fill:#eee,stroke:#999,"
                        "stroke-width:2px,stroke-dasharray:5 4"
                    )
                lines.append(f"    {previous} -.-> {device_id}")
                previous = device_id
    lines.append("```")
