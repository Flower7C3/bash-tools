def table(title, items, headers):
    lines.extend(["", f"## {title} ({len(items)})", ""])
    if not items:
        lines.append("_none_")
        return
    lines.append("| " + " | ".join(headers) + " |")
    lines.append("| " + " | ".join("---" for _ in headers) + " |")
    for item in items:
        lines.append("| " + " | ".join(str(v or "").replace("|", "\\|") for v in item) + " |")


CHART_MAX_SLICES = 8
TOPOLOGY_LABEL_WIDTH = 22


def wrap_label(text, width=TOPOLOGY_LABEL_WIDTH):
    """Break a long label into mermaid `<br/>` separated chunks."""
    words = str(text).split()
    if not words:
        return ""
    chunks = []
    current = words[0]
    for word in words[1:]:
        if len(current) + 1 + len(word) <= width:
            current = f"{current} {word}"
        else:
            chunks.append(current)
            current = word
    chunks.append(current)
    return "<br/>".join(chunks)


def mermaid_escape(value):
    """Make a label safe inside a mermaid node or pie slice.

    `<br/>` is preserved on purpose: it is mermaid's own line break and keeps
    long device labels from widening the layout.
    """
    text = str(value or "")
    keep_breaks = "<br/>" in text
    text = text.replace("\\", "/").replace('"', "'").replace("\n", " ").replace(";", ",")
    if not keep_breaks:
        text = text.replace("<", "(").replace(">", ")")
    return text.strip() or "unknown"


def pie(title, counts):
    """Mermaid pie chart of {label: count}."""
    lines.extend(["", f"## {title}", ""])
    if not counts:
        lines.append("_no data_")
        return
    items = list(counts.items())
    if len(items) > CHART_MAX_SLICES:
        head = items[: CHART_MAX_SLICES - 1]
        rest = sum(c for _, c in items[CHART_MAX_SLICES - 1 :])
        items = head + [("Other", rest)]
    lines.append("```mermaid")
    lines.append("pie showData")
    for label, count in items:
        lines.append(f'    "{mermaid_escape(label)}" : {count}')
    lines.append("```")


