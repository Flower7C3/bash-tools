#!/usr/bin/env bash
# Extra/orphan commits on line branches, unmerged topic refs, and open PRs vs base.
# CLI prints text. --out writes Markdown.
#
# Usage: ./not-on-base [OPTIONS] [repo...]

set -euo pipefail

main() {
  if [[ ! -f "$(dirname "$0")/common-functions" ]]; then
    echo "Downloading common-functions from GitHub..."
    if ! curl -fsSL https://raw.githubusercontent.com/Flower7C3/bash-tools/master/common-functions -o "$(dirname "$0")/common-functions"; then
      echo "Failed to download common-functions"
      exit 1
    fi
  fi
  # shellcheck source=common-functions
  source "$(dirname "$0")/common-functions"
  not_on_base_main "$@"
}

not_on_base_main() {
  local BASE="main"
  local FROM="uat,develop"
  local OUT=""
  local DO_FETCH=0
  local NO_GH=0
  local GH_ON=0
  local GH_LOADED_FOR=""
  local -a REPOS=()
  local -a VALID_REPOS=()
  local -a LINE_BRANCHES=()
  local -a LINE_GIT_ARGS=()
  local -A PR_NUM=()
  local -A PR_URL=()
  local -A PR_STATE=()
  local ICON_OK=$'\u2705'
  local ICON_EXTRA=$'\u2B06\uFE0F'
  local ICON_ORPHAN=$'\u26A0\uFE0F'
  local ICON_REPO=$'\U0001F4E6'
  local ICON_PIN=$'\U0001F4CC'
  local ICON_BRANCH=$'\U0001F33F'
  local ICON_PR=$'\U0001F517'
  local ICON_NONE='—'

  show_usage() {
    log_usage_title '[OPTIONS] [repo...]'
    echo
    echo 'What is not on the base branch: extra/orphan commits on line branches,'
    echo 'unmerged topic refs, and open GitHub PRs (if gh is logged in).'
    echo 'Stdout is text. Use --out to export Markdown.'
    echo
    log_header 'Options'
    log_usage_options_line '--base <branch>' 'Base branch (default: main)'
    log_usage_options_line '--from <uat,develop,...>' 'Line branches (default: uat,develop)'
    log_usage_options_line '--out;-o <file.md>' 'Write Markdown (use - for stdout)'
    log_usage_options_line '--no-gh' 'Skip GitHub even if gh is available'
    log_usage_options_line '--fetch' 'git fetch --prune origin first'
    log_usage_options_line '-u;--update' 'Update app'
    log_usage_options_line '-h;--help' 'Show this help message'
    echo
    log_header 'Examples'
    log_usage_example_line
    log_usage_example_line '--fetch --out report.md repo-a repo-b'
    log_usage_example_line '--base main --from uat,develop .'
    exit 0
  }

  origin_ref() {
    local r="$1" b="$2"
    if git -C "$r" rev-parse --verify --quiet "origin/${b}" >/dev/null; then
      echo "origin/${b}"
      return 0
    fi
    if git -C "$r" rev-parse --verify --quiet "${b}" >/dev/null; then
      echo "${b}"
      return 0
    fi
    return 1
  }

  tip_ref_for() {
    local r="$1" name="$2"
    if git -C "$r" rev-parse --verify --quiet "origin/${name}" >/dev/null; then
      echo "origin/${name}"
      return 0
    fi
    if git -C "$r" rev-parse --verify --quiet "${name}" >/dev/null; then
      echo "${name}"
      return 0
    fi
    return 1
  }

  sanitize_id() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9' '_' | sed 's/_$//'
  }

  topic_name_for() {
    local r="$1" sha="$2"
    local name
    name="$(
      git -C "$r" name-rev --name-only \
        --exclude="refs/remotes/origin/HEAD" \
        --exclude="refs/remotes/origin/${BASE}" \
        --exclude="refs/heads/${BASE}" \
        --exclude="refs/remotes/origin/uat" \
        --exclude="refs/heads/uat" \
        --exclude="refs/remotes/origin/develop" \
        --exclude="refs/heads/develop" \
        "$sha" 2>/dev/null || echo undefined
    )"
    name="${name%%~*}"
    name="${name#remotes/}"
    name="${name#origin/}"
    if [[ -z "$name" || "$name" == "undefined" ]]; then
      echo ""
      return 1
    fi
    echo "$name"
  }

  probe_gh() {
    GH_ON=0
    [[ "$NO_GH" -eq 1 ]] && return 1
    command_exists gh || return 1
    gh auth status >/dev/null 2>&1 || return 1
    GH_ON=1
  }

  ensure_gh_cache() {
    local r="$1" num url state head
    [[ "$GH_ON" -eq 1 ]] || return 0
    [[ "$GH_LOADED_FOR" == "$r" ]] && return 0
    PR_NUM=()
    PR_URL=()
    PR_STATE=()
    GH_LOADED_FOR="$r"
    while IFS=$'\t' read -r num url state head; do
      [[ -z "${head:-}" ]] && continue
      PR_NUM["$head"]="$num"
      PR_URL["$head"]="$url"
      PR_STATE["$head"]="$state"
    done < <(
      (
        cd "$r" || exit 0
        gh pr list --state all --limit 200 \
          --json number,url,state,headRefName \
          --jq '.[] | [.number, .url, .state, .headRefName] | @tsv'
      ) 2>/dev/null || true
    )
  }

  head_for_pr() {
    local name="$1"
    name="${name#refs/heads/}"
    name="${name#refs/remotes/origin/}"
    name="${name#origin/}"
    echo "$name"
  }

  pr_md() {
    local head
    head="$(head_for_pr "$1")"
    if [[ -n "${PR_NUM[$head]:-}" ]]; then
      printf '[#%s](%s) %s' "${PR_NUM[$head]}" "${PR_URL[$head]}" "${PR_STATE[$head]}"
    fi
  }

  pr_plain() {
    local head
    head="$(head_for_pr "$1")"
    if [[ -n "${PR_NUM[$head]:-}" ]]; then
      printf '#%s %s' "${PR_NUM[$head]}" "${PR_STATE[$head]}"
    fi
  }

  fill_line_git_args() {
    local r="$1" line="$2"
    local base_ref from_ref prev prev_ref
    LINE_GIT_ARGS=()
    base_ref="$(origin_ref "$r" "$BASE")" || return 1
    from_ref="$(origin_ref "$r" "$line")" || return 1
    LINE_GIT_ARGS=("${base_ref}..${from_ref}")
    for prev in "${LINE_BRANCHES[@]}"; do
      [[ "$prev" == "$line" ]] && break
      prev_ref="$(origin_ref "$r" "$prev")" || continue
      LINE_GIT_ARGS+=(--not "$prev_ref")
    done
  }

  not_on_label() {
    local line="$1" prev out="${BASE}"
    for prev in "${LINE_BRANCHES[@]}"; do
      [[ "$prev" == "$line" ]] && break
      out+=" / ${prev}"
    done
    echo "$out"
  }

  classify_line() {
    local r="$1" line="$2"
    local sha total=0 live=0 orphan=0
    fill_line_git_args "$r" "$line" || {
      echo "0 0 0"
      return
    }
    while IFS= read -r sha; do
      [[ -z "$sha" ]] && continue
      total=$((total + 1))
      if topic_name_for "$r" "$sha" >/dev/null; then
        live=$((live + 1))
      else
        orphan=$((orphan + 1))
      fi
    done < <(git -C "$r" rev-list --no-merges "${LINE_GIT_ARGS[@]}")
    echo "${total} ${live} ${orphan}"
  }

  line_role() {
    if [[ "$1" == "${LINE_BRANCHES[0]}" ]]; then
      echo "primary"
    else
      echo "other"
    fi
  }

  is_line_name() {
    local n="$1" line
    [[ "$n" == "$BASE" ]] && return 0
    for line in "${LINE_BRANCHES[@]}"; do
      [[ "$n" == "$line" ]] && return 0
    done
    return 1
  }

  collect_topic_branches() {
    local r="$1" base_ref="$2"
    local ref name tip
    git -C "$r" for-each-ref --format='%(refname)' --no-merged="$base_ref" \
      refs/heads refs/remotes/origin |
      while IFS= read -r ref; do
        [[ -z "$ref" ]] && continue
        name="${ref#refs/heads/}"
        name="${name#refs/remotes/origin/}"
        name="${name#refs/remotes/}"
        [[ "$name" == "HEAD" || "$name" == "origin/HEAD" ]] && continue
        is_line_name "$name" && continue
        tip="$(tip_ref_for "$r" "$name")" || continue
        printf '%s|%s\n' "$(git -C "$r" log -1 --format='%ct' "$tip")" "$name"
      done | sort -t'|' -k1,1nr | awk -F'|' '!seen[$2]++ { print $2 }'
  }

  each_commit() {
    local r="$1" kind="$2"
    shift 2
    local sha short date subj topic
    while IFS='|' read -r sha short date subj; do
      [[ -z "$sha" ]] && continue
      if topic="$(topic_name_for "$r" "$sha")"; then
        [[ "$kind" == "orphan" ]] && continue
        echo "${short}|${date}|${subj}|${topic}"
      else
        [[ "$kind" == "live" ]] && continue
        echo "${short}|${date}|${subj}|"
      fi
    done < <(git -C "$r" log --no-merges --format='%H|%h|%as|%s' "$@")
  }

  open_pr_count() {
    local head n=0
    for head in "${!PR_STATE[@]}"; do
      [[ "${PR_STATE[$head]}" == "OPEN" ]] && n=$((n + 1))
    done
    echo "$n"
  }

  icon_for_count() {
    local n="$1" bad="$2"
    if [[ "${n:-0}" -eq 0 ]]; then
      echo "$ICON_OK"
    else
      echo "$bad"
    fi
  }

  # --- text ---

  emit_text() {
    local r name base_ref from_ref line short subj
    local total live orphan short date topic pr
    echo "Not on ${BASE}  $(date '+%Y-%m-%d %H:%M %Z')"
    echo "  ${ICON_OK} ok  ${ICON_EXTRA} extra  ${ICON_ORPHAN} orphan  ${ICON_BRANCH} topic  ${ICON_PR} PR"
    echo "Lines: ${FROM}"
    [[ "$GH_ON" -eq 1 ]] && echo "GitHub: gh"
    echo
    local i=0
    for r in "${VALID_REPOS[@]}"; do
      if [[ "$i" -gt 0 ]]; then
        echo "--------------------------------------------------------------------------------"
        echo
      fi
      i=$((i + 1))
      name="$(basename "$r")"
      echo "${ICON_REPO} ${name}"
      echo "  ${r}"
      base_ref="$(origin_ref "$r" "$BASE")" || {
        echo "  ${ICON_ORPHAN} no ${BASE}"
        echo
        continue
      }
      ensure_gh_cache "$r"
      printf "  %s %-10s %s  %s\n" "$ICON_PIN" "$BASE" "$(git -C "$r" log -1 --format='%h' "$base_ref")" "$(git -C "$r" log -1 --format='%s' "$base_ref")"
      for line in "${LINE_BRANCHES[@]}"; do
        from_ref="$(origin_ref "$r" "$line")" || {
          printf "  %s %-10s %s\n" "$ICON_PIN" "$line" "$ICON_NONE"
          continue
        }
        printf "  %s %-10s %s  %s\n" "$ICON_PIN" "$line" "$(git -C "$r" log -1 --format='%h' "$from_ref")" "$(git -C "$r" log -1 --format='%s' "$from_ref")"
      done
      echo

      for line in "${LINE_BRANCHES[@]}"; do
        fill_line_git_args "$r" "$line" || continue
        read -r total live orphan <<<"$(classify_line "$r" "$line")"
        echo "  $(icon_for_count "$live" "$ICON_EXTRA") extra ${line}  (${live}, not on $(not_on_label "$line"))"
        if [[ "$live" -eq 0 ]]; then
          echo "    ${ICON_OK}"
        else
          while IFS='|' read -r short date subj topic; do
            pr=""
            [[ "$GH_ON" -eq 1 ]] && pr="$(pr_plain "$topic")"
            printf "    %s %s  %s  %s  %s" "$ICON_EXTRA" "$short" "$date" "$subj" "$topic"
            [[ -n "$pr" ]] && printf "  %s %s" "$ICON_PR" "$pr"
            echo
          done < <(each_commit "$r" live "${LINE_GIT_ARGS[@]}")
        fi
        echo
        echo "  $(icon_for_count "$orphan" "$ICON_ORPHAN") orphan ${line}  (${orphan}, not on $(not_on_label "$line"))"
        if [[ "$orphan" -eq 0 ]]; then
          echo "    ${ICON_OK}"
        else
          while IFS='|' read -r short date subj topic; do
            printf "    %s %s  %s  %s\n" "$ICON_ORPHAN" "$short" "$date" "$subj"
          done < <(each_commit "$r" orphan "${LINE_GIT_ARGS[@]}")
        fi
        echo
      done

      local b tip_ref any_b=0 n_b
      n_b="$(collect_topic_branches "$r" "$base_ref" | grep -c . || true)"
      echo "  $(icon_for_count "$n_b" "$ICON_BRANCH") topic branches  (${n_b}, not merged to ${BASE})"
      while IFS= read -r b; do
        [[ -z "$b" ]] && continue
        tip_ref="$(tip_ref_for "$r" "$b")" || continue
        any_b=1
        pr=""
        [[ "$GH_ON" -eq 1 ]] && pr="$(pr_plain "$b")"
        printf "    %s %s  %s  %s" "$ICON_BRANCH" "$b" "$(git -C "$r" log -1 --format='%h %as' "$tip_ref")" "$(git -C "$r" log -1 --format='%s' "$tip_ref")"
        [[ -n "$pr" ]] && printf "  %s %s" "$ICON_PR" "$pr"
        echo
      done < <(collect_topic_branches "$r" "$base_ref")
      [[ "$any_b" -eq 0 ]] && echo "    ${ICON_OK}"
      echo

      if [[ "$GH_ON" -eq 1 ]]; then
        echo "  $(icon_for_count "$(open_pr_count)" "$ICON_PR") open PRs to ${BASE}  ($(open_pr_count))"
        emit_open_prs_text "$r"
        echo
      fi
    done
  }

  emit_open_prs_text() {
    local r="$1" n
    n="$(open_pr_count)"
    if [[ "$n" -eq 0 ]]; then
      echo "    ${ICON_OK}"
      return
    fi
    (
      cd "$r" || exit 0
      gh pr list --base "$BASE" --state open --limit 100 \
        --json number,state,headRefName,title \
        --jq --arg icon "$ICON_PR" '.[] | "    \($icon) #\(.number)  \(.state)  \(.headRefName)  \(.title)"'
    ) 2>/dev/null || echo "    ${ICON_NONE}"
  }

  # --- markdown ---

  emit_summary_table() {
    echo "## Summary"
    echo
    local header="| Repo" sep="| ---" line
    for line in "${LINE_BRANCHES[@]}"; do
      header+=" | ${ICON_EXTRA} Extra \`${line}\` | ${ICON_ORPHAN} Orphan \`${line}\`"
      sep+=" | ---: | ---:"
    done
    header+=" | ${ICON_BRANCH} Topics"
    sep+=" | ---:"
    if [[ "$GH_ON" -eq 1 ]]; then
      header+=" | ${ICON_PR} PRs"
      sep+=" | ---:"
    fi
    echo "${header} |"
    echo "${sep} |"
    local r total live orphan row base_ref n_b
    for r in "${VALID_REPOS[@]}"; do
      row="| $(basename "$r")"
      for line in "${LINE_BRANCHES[@]}"; do
        read -r total live orphan <<<"$(classify_line "$r" "$line")"
        row+=" | ${live} | ${orphan}"
      done
      base_ref="$(origin_ref "$r" "$BASE")" || base_ref=""
      n_b=0
      if [[ -n "$base_ref" ]]; then
        n_b="$(collect_topic_branches "$r" "$base_ref" | grep -c . || true)"
      fi
      row+=" | ${n_b}"
      if [[ "$GH_ON" -eq 1 ]]; then
        ensure_gh_cache "$r"
        row+=" | $(open_pr_count)"
      fi
      echo "${row} |"
    done
  }

  emit_summary_mermaid() {
    echo "flowchart LR"
    local r id total live orphan line role i
    for r in "${VALID_REPOS[@]}"; do
      id="$(sanitize_id "$(basename "$r")")"
      echo "  subgraph ${id}[\"$(basename "$r")\"]"
      i=0
      for line in "${LINE_BRANCHES[@]}"; do
        role="$(line_role "$line")"
        read -r total live orphan <<<"$(classify_line "$r" "$line")"
        echo "    ${id}_${i}E[\"Extra ${line} (${role}) +${live}\"]"
        echo "    ${id}_${i}O[\"Orphan ${line} (${role}) +${orphan}\"]"
        [[ "$i" -eq 0 ]] && echo "    ${id}_M[\"${BASE}\"]"
        echo "    ${id}_${i}E -.-> ${id}_M"
        i=$((i + 1))
      done
      echo "  end"
    done
  }

  emit_repo_mermaid() {
    local r="$1" line="$2"
    shift 2
    echo '```mermaid'
    echo "flowchart TB"
    echo "  src[\"${line}\"]"
    local sha short date subj topic nid any=0
    local -a seen=()
    while IFS='|' read -r sha short date subj; do
      [[ -z "$sha" ]] && continue
      topic="$(topic_name_for "$r" "$sha")" || continue
      nid="$(sanitize_id "$topic")"
      if [[ ! " ${seen[*]-} " =~ \ ${nid}\  ]]; then
        seen+=("$nid")
        echo "  ${nid}[\"${topic}\"]"
        echo "  src --> ${nid}"
        any=1
      fi
    done < <(git -C "$r" log --no-merges --format='%H|%h|%as|%s' "$@")
    if [[ "$any" -eq 0 ]]; then
      echo "  none[\"none\"]"
      echo "  src --> none"
    fi
    echo '```'
  }

  emit_md_unique() {
    local r="$1" line="$2"
    local total live orphan short date subj topic pr
    fill_line_git_args "$r" "$line" || return 0
    read -r total live orphan <<<"$(classify_line "$r" "$line")"

    echo "### $(icon_for_count "$live" "$ICON_EXTRA") Extra on \`${line}\` ($(line_role "$line"), ${live}, not on \`$(not_on_label "$line")\`)"
    echo
    if [[ "$live" -eq 0 ]]; then
      echo "_None._"
      echo
    else
      if [[ "$GH_ON" -eq 1 ]]; then
        echo "| SHA | Date | Subject | Topic | PR |"
        echo "| --- | --- | --- | --- | --- |"
      else
        echo "| SHA | Date | Subject | Topic |"
        echo "| --- | --- | --- | --- |"
      fi
      while IFS='|' read -r short date subj topic; do
        if [[ "$GH_ON" -eq 1 ]]; then
          pr="$(pr_md "$topic")"
          echo "| \`${short}\` | ${date} | ${subj} | \`${topic}\` | ${pr} |"
        else
          echo "| \`${short}\` | ${date} | ${subj} | \`${topic}\` |"
        fi
      done < <(each_commit "$r" live "${LINE_GIT_ARGS[@]}")
      echo
      emit_repo_mermaid "$r" "$line" "${LINE_GIT_ARGS[@]}"
      echo
    fi

    echo "### $(icon_for_count "$orphan" "$ICON_ORPHAN") Orphan on \`${line}\` ($(line_role "$line"), ${orphan}, not on \`$(not_on_label "$line")\`)"
    echo
    if [[ "$orphan" -eq 0 ]]; then
      echo "_None._"
      echo
    else
      echo "| SHA | Date | Subject |"
      echo "| --- | --- | --- |"
      while IFS='|' read -r short date subj topic; do
        echo "| \`${short}\` | ${date} | ${subj} |"
      done < <(each_commit "$r" orphan "${LINE_GIT_ARGS[@]}")
      echo
    fi
  }

  emit_md_branches() {
    local r="$1" base_ref="$2"
    local b tip_ref short date subj pr any=0
    echo "### ${ICON_BRANCH} Topic branches not merged to \`${BASE}\`"
    echo
    if [[ "$GH_ON" -eq 1 ]]; then
      echo "| Branch | Tip | Date | Subject | PR |"
      echo "| --- | --- | --- | --- | --- |"
    else
      echo "| Branch | Tip | Date | Subject |"
      echo "| --- | --- | --- | --- |"
    fi
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      tip_ref="$(tip_ref_for "$r" "$b")" || continue
      any=1
      short="$(git -C "$r" log -1 --format='%h' "$tip_ref")"
      date="$(git -C "$r" log -1 --format='%as' "$tip_ref")"
      subj="$(git -C "$r" log -1 --format='%s' "$tip_ref")"
      if [[ "$GH_ON" -eq 1 ]]; then
        pr="$(pr_md "$b")"
        echo "| \`${b}\` | \`${short}\` | ${date} | ${subj} | ${pr} |"
      else
        echo "| \`${b}\` | \`${short}\` | ${date} | ${subj} |"
      fi
    done < <(collect_topic_branches "$r" "$base_ref")
    if [[ "$any" -eq 0 ]]; then
      echo
      echo "_None._"
    fi
    echo
  }

  emit_md_prs() {
    local r="$1"
    [[ "$GH_ON" -eq 1 ]] || return 0
    echo "### ${ICON_PR} Open PRs to \`${BASE}\` (GitHub)"
    echo
    if [[ "$(open_pr_count)" -eq 0 ]]; then
      echo "_None._"
      echo
      return
    fi
    echo "| PR | Head | State | Title |"
    echo "| --- | --- | --- | --- |"
    (
      cd "$r" || exit 0
      gh pr list --base "$BASE" --state open --limit 100 \
        --json number,url,state,headRefName,title \
        --jq '.[] | "| [#\(.number)](\(.url)) | `\(.headRefName)` | \(.state) | \(.title) |"'
    ) 2>/dev/null || true
    echo
  }

  emit_markdown() {
    local r name base_ref from_ref line rest="" j
    echo "# Not on \`${BASE}\`"
    echo
    echo "Generated: $(date '+%Y-%m-%d %H:%M %Z')"
    echo
    echo "Extra/orphan commits on line branches, topic refs not merged into \`${BASE}\`."
    [[ "$GH_ON" -eq 1 ]] && echo "Open PRs from \`gh\`."
    echo
    echo "| | |"
    echo "| --- | --- |"
    echo "| Base | \`${BASE}\` |"
    echo "| Lines | \`${FROM}\` |"
    echo "| Icons | ${ICON_OK} ok · ${ICON_EXTRA} extra · ${ICON_ORPHAN} orphan · ${ICON_BRANCH} topic · ${ICON_PR} PR |"
    [[ "$GH_ON" -eq 1 ]] && echo "| GitHub | \`gh\` |"
    echo
    emit_summary_table
    echo
    echo '```mermaid'
    emit_summary_mermaid
    echo '```'
    echo
    local i=0
    for r in "${VALID_REPOS[@]}"; do
      if [[ "$i" -gt 0 ]]; then
        echo
        echo '---'
        echo
      fi
      i=$((i + 1))
      name="$(basename "$r")"
      echo "## ${ICON_REPO} ${name}"
      echo
      echo "Path: \`${r}\`"
      echo
      base_ref="$(origin_ref "$r" "$BASE")" || {
        echo "_No \`${BASE}\` ref._"
        echo
        continue
      }
      echo "| Ref | Tip | Subject |"
      echo "| --- | --- | --- |"
      echo "| \`${BASE}\` | \`$(git -C "$r" log -1 --format='%h' "$base_ref")\` | $(git -C "$r" log -1 --format='%s' "$base_ref") |"
      for line in "${LINE_BRANCHES[@]}"; do
        from_ref="$(origin_ref "$r" "$line")" || {
          echo "| \`${line}\` | — | _missing_ |"
          continue
        }
        echo "| \`${line}\` | \`$(git -C "$r" log -1 --format='%h' "$from_ref")\` | $(git -C "$r" log -1 --format='%s' "$from_ref") |"
      done
      echo
      ensure_gh_cache "$r"
      for line in "${LINE_BRANCHES[@]}"; do
        emit_md_unique "$r" "$line"
      done
      emit_md_branches "$r" "$base_ref"
      emit_md_prs "$r"
    done
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help) show_usage ;;
    -u | --update) update_application ;;
    --base)
      shift
      BASE="${1:-}"
      [[ -n "$BASE" ]] || die 1 '--base needs a branch name'
      ;;
    --from)
      shift
      FROM="${1:-}"
      [[ -n "$FROM" ]] || die 1 '--from needs a comma-separated list'
      ;;
    --out | -o)
      shift
      OUT="${1:-}"
      [[ -n "$OUT" ]] || die 1 '--out needs a file path or -'
      ;;
    --fetch) DO_FETCH=1 ;;
    --no-gh) NO_GH=1 ;;
    --)
      shift
      REPOS+=("$@")
      break
      ;;
    -*) die 1 'Unknown option: %s' "$1" ;;
    *) REPOS+=("$1") ;;
    esac
    shift
  done

  if [[ ${#REPOS[@]} -eq 0 ]]; then
    REPOS=("$(pwd)")
  fi

  check_dependencies git
  [[ -z "$OUT" ]] && log_title "Not on ${BASE}"

  local IFS=','
  read -r -a LINE_BRANCHES <<<"$FROM"
  unset IFS

  local repo
  for repo in "${REPOS[@]}"; do
    repo="$(cd "$repo" && pwd)"
    if [[ ! -d "$repo/.git" ]] && [[ ! -f "$repo/.git" ]]; then
      log_warning 'Skip (not a git repo): <code>%s</code>' "$repo"
      continue
    fi
    VALID_REPOS+=("$repo")
  done
  [[ ${#VALID_REPOS[@]} -gt 0 ]] || die 1 'No git repos to scan'

  if [[ "$DO_FETCH" -eq 1 ]]; then
    for repo in "${VALID_REPOS[@]}"; do
      log_info 'Fetch <code>%s</code>' "$(basename "$repo")"
      git -C "$repo" fetch --prune origin >/dev/null
    done
  fi

  probe_gh || true
  if [[ -z "$OUT" && "$GH_ON" -eq 1 ]]; then
    log_info 'GitHub PRs via <code>gh</code>'
  fi

  if [[ -n "$OUT" ]]; then
    if [[ "$OUT" == "-" ]]; then
      emit_markdown
    else
      mkdir -p "$(dirname "$OUT")"
      emit_markdown >"$OUT"
      log_success 'Wrote <code>%s</code>' "$OUT"
    fi
    return 0
  fi

  emit_text
}

main "$@"
